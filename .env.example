# Used by docker-compose.yml. Copy to .env and change the secrets before any real deployment.
POSTGRES_USER=outlet_hq
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=outlet_hq
# At least 32 characters. Signs the API's login tokens.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Three-letter ISO 4217 code; all prices are stored in this currency's minor units.
CURRENCY=MYR
# Load demo outlets, menu, stock and users when the API starts (only if the database is empty).
SEED_DEMO_DATA=true
# Sign-in attempts per client address per minute. Keep 10 in production; the e2e run raises it.
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Host ports for the API and the web app.
API_PORT=3000
WEB_PORT=8080

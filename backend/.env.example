NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://outlet_hq:outlet_hq@localhost:5432/outlet_hq
# At least 32 characters.
JWT_SECRET=dev-only-secret-change-me-at-least-32-chars
JWT_EXPIRES_IN=8h
CURRENCY=MYR
# Comma-separated origins allowed to call the API from a browser (the web app in dev).
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
LOGIN_RATE_LIMIT_PER_MINUTE=10
RUN_MIGRATIONS=false
SEED_DEMO_DATA=false
# Used only by `npm test`: a database the tests may wipe.
TEST_DATABASE_URL=postgres://outlet_hq:outlet_hq@localhost:5432/outlet_hq_test

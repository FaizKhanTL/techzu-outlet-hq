{
  "name": "outlet-hq-api",
  "version": "1.0.0",
  "private": true,
  "description": "Outlet HQ API: master menu, outlet assignment, per-outlet inventory, sales and reports",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "test": "npm run test:unit && npm run test:integration",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage --coverage.reportsDirectory=coverage/unit && vitest run --config vitest.integration.config.ts --coverage --coverage.reportsDirectory=coverage/integration"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "swagger-ui-dist": "5.34.1",
    "swagger-ui-express": "5.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@eslint/js": "9.20.0",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.8",
    "@types/node": "22.13.1",
    "@types/pg": "8.11.11",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.20.0",
    "eslint-config-prettier": "10.0.1",
    "globals": "15.14.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.5.0",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.24.0",
    "vitest": "3.0.5"
  }
}
